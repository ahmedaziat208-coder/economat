rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all safety: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Core ERP Collections
    match /materials/{materialId} {
      allow read, write: if isValidId(materialId);
    }

    match /stock_movements/{movementId} {
      allow read, write: if isValidId(movementId);
    }

    match /recipes/{recipeId} {
      allow read, write: if isValidId(recipeId);
    }

    match /suppliers/{supplierId} {
      allow read, write: if isValidId(supplierId);
    }

    match /invoices/{invoiceId} {
      allow read, write: if isValidId(invoiceId);
    }

    match /purchase_orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    match /system_snapshots/{snapshotId} {
      allow read, write: if isValidId(snapshotId);
    }
  }
}
